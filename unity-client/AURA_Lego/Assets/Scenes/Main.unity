  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LegoTwin.Character.NPCSpeechBubble
  _bubbleText: {fileID: 1288937708}
  _canvasGroup: {fileID: 212404413}
  _messages:
  - "\uD558\uD558\uD558! \uB098\uB294 \uCC9C\uB465\uC758 \uC2E0 \uD1A0\uB974\uB2E4!
    \uB0B4 \uBB20\uB2C8\uB974 \uBE0C\uB9AD \uB9DB\uC744 \uC81C\uB300\uB85C \uBCF4\uC5EC\uC8FC\uB9C8!"
  - "\uC774 \uBB20\uB2C8\uB974 \uBE0C\uB9AD\uC740 \uC790\uACA9 \uC788\uB294 \uC790\uB9CC\uC774
    \uC870\uB9BD\uD560 \uC218 \uC788\uB2E4! \uB10C \uC124\uBA85\uC11C\uBD80\uD130
    \uB2E4\uC2DC \uC77D\uACE0 \uC640\uB77C!"
  - "\uB0B4 \uBC88\uAC1C \uBE0C\uB9AD\uC73C\uB85C \uB180\uC774\uACF5\uC6D0\uC744
    \uC544\uC8FC \uB208\uBD80\uC2DC\uAC8C \uBC1D\uD600\uC8FC\uC9C0!"
  - "\uC624\uB518\uC758 \uC218\uC5FC\uC744 \uAC78\uACE0! \uB0B4 \uBE68\uAC04\uC0C9
    \uB9DD\uD1A0 \uBE0C\uB9AD\uBCF4\uB2E4 \uBA4B\uC9C4 \uC870\uAC01\uC740 \uC774
    \uC138\uC0C1\uC5D0 \uC5C6\uB2E4!"
  _displayDuration: 6
  _fadeDuration: 0.4
  _hideDuration: 2
