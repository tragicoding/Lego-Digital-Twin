  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LegoTwin.Character.NPCSpeechBubble
  _bubbleText: {fileID: 422318914475620306}
  _canvasGroup: {fileID: 7024309836675203680}
  _messages:
  - "\uC624\uB298\uC740 \uC548 \uBD80\uC21C\uB2E4! \uD5D0\uD06C, \uC870\uB9BD\uD558\uB294
    \uAC70 \uB3D5\uB294\uB2E4! \uC774 \uBB34\uAC70\uC6B4 \uBE0C\uB9AD\uC740 \uD5D0\uD06C\uAC00
    \uC62E\uACA8\uC8FC\uACA0\uB2E4!"
  - "\uD5D0\uD06C, \uC791\uC740 \uCE5C\uAD6C\uB4E4 \uC88B\uB2E4. \uADF8\uB7F0\uB370
    \uD5D0\uD06C \uC190\uAC00\uB77D\uC774 \uB108\uBB34 \uCEE4\uC11C \uC774 \uC870\uADF8\uB9CC
    \uB808\uACE0 \uCEF5\uC740 \uC7A1\uC744 \uC218\uAC00 \uC5C6\uB2E4..."
  - "\uB2E4\uCE5C \uC0AC\uB78C \uC5C6\uB098? \uD5D0\uD06C\uAC00 \uB4F1 \uB4A4\uC5D0
    \uC228\uACA8\uC904 \uD14C\uB2C8 \uAC71\uC815 \uB9C8\uB77C! \uD5D0\uD06C\uB294
    \uD06C\uACE0 \uD2BC\uD2BC\uD558\uB2E4!"
  _displayDuration: 6
  _fadeDuration: 0.4
  _hideDuration: 2
