# ====================================================================
# [Root] LEGO Amusement Park Digital Twin - Master Ignore
# ====================================================================

# --- OS & IDE Specific ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.bak
.env
.env.local

# --- Unity Client (unity-client/) ---
# 유니티는 라이브러리와 임시 파일을 제외하는 것이 핵심입니다.
unity-client/**/[Ll]ibrary/
unity-client/**/[Tt]emp/
unity-client/**/[Oo]bj/
unity-client/**/[Bb]uild/
unity-client/**/[Bb]uilds/
unity-client/**/[Ll]ogs/
unity-client/**/[Mm]emoryCaptures/
# UserSettings: 에디터 레이아웃·개인 설정 (사용자별로 달라 충돌만 유발)
unity-client/**/UserSettings/

# 에러가 났던 샘플 및 스타터 에셋 (필요 없다면 제외 권장)
# unity-client/**/Assets/Samples/

# Unity 자동 생성 파일
unity-client/**/*.csproj
unity-client/**/*.sln
unity-client/**/*.user
unity-client/**/*.userprefs
unity-client/**/*.pidb
unity-client/**/*.suo

# Assets 내 .meta 파일은 '반드시' 포함해야 하므로 예외 처리
!unity-client/**/Assets/**/*.meta

# --- Middleware Server (middleware-server/) ---
middleware-server/node_modules/
middleware-server/npm-debug.log*
middleware-server/.pnpm-debug.log*

# --- Vision Engine (vision-engine/) ---
vision-engine/__pycache__/
vision-engine/*.py[cod]
vision-engine/venv/
vision-engine/env/
vision-engine/.venv/
vision-engine/.pytest_cache/
# 인식 테스트용 임시 결과물 이미지 제외
vision-engine/data/output/
vision-engine/debug_*.jpg

# --- Hardware (hardware-controller/) ---
hardware-controller/build/
hardware-controller/*.hex
hardware-controller/*.elf

# --- Large Binary & Package Files ---
# 설치 패키지 (수 GB)
*.deb
*.rpm

# --- ML Model Weights & Checkpoints ---
# 수백 MB ~ GB급 모델 파일
*.pth
*.pt
*.ckpt
*.safetensors
*.bin
apps/engine-vision/Wonder3D/ckpts/

# --- Wonder3D 실험 결과물 ---
# 3D 재구성 결과 (obj, ply 등) 및 학습 로그
apps/engine-vision/Wonder3D/instant-nsr-pl/exp/
apps/engine-vision/Wonder3D/outputs/
apps/engine-vision/Wonder3D/runs/

# --- Wonder3D 입력 캡처 이미지 ---
# 실험용으로 촬영된 lego 이미지들
apps/engine-vision/Wonder3D/inputs/

# --- Python 캐시 ---
apps/engine-vision/Wonder3D/__pycache__/
**/__pycache__/
**/*.py[cod]
apps/engine-vision/Wonder3D/benchmark_dashboard.html
apps/engine-vision/Wonder3D/benchmark_log.json

# --- Backend storage (업로드 이미지 & 생성 모델) ---
apps/backend/storage/images/*/
apps/backend/storage/models/

# --- Frontend build cache & dependencies ---
apps/frontend/.vite/
apps/frontend/node_modules/
apps/frontend/dist/
apps/frontend/dist-admin/

# --- Root level vite cache ---
.vite/

# --- Local run logs ---
history/.run_logs/

# --- Windows Zone.Identifier 파일 ---
*.Zone.Identifier
*:Zone.Identifier

# --- TriLib 2 (Unity Asset Store 유료 에셋) ---
# public 저장소라 재배포(EULA 위반) 방지를 위해 커밋 금지.
# 각 개발자가 본인 Unity 계정으로 Asset Store에서 설치한다.
# (TripoFbxLoader 는 TRILIB define 으로 가드되어 미설치 시 Mock 폴백)
# 폴더 제외가 내부 .meta 재포함(위 !*.meta)을 차단하며,
# 폴더 자체의 .meta 는 아래에서 명시적으로 제외(뒤 규칙이 우선).
unity-client/**/Assets/TriLib/
unity-client/**/Assets/TriLib.meta
unity-client/**/Assets/TriLibInstaller/
unity-client/**/Assets/TriLibInstaller.meta

# TriLibDefineSetup 이 TriLib 설치 PC 에서 로컬 생성하는 컴파일러 응답 파일.
# TRILIB define 을 ProjectSettings 가 아닌 여기에만 기록 → 저장소로 새지 않게 제외.
# (위 39행 !**/Assets/**/*.meta 가 .meta 를 재포함하므로 .meta 도 명시적으로 제외)
unity-client/**/Assets/csc.rsp
unity-client/**/Assets/csc.rsp.meta
